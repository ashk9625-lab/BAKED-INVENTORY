generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StockMovementType {
  RECEIVE
  ISSUE_TO_PRODUCTION
  PRODUCTION_OUTPUT
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  WASTE
  TRANSFER_IN
  TRANSFER_OUT
}

model Product {
  id              Int                 @id @default(autoincrement())
  sku             String              @unique
  name            String
  category        String
  unit            String              @default("unit")
  barcode         String?
  location        String?
  costPrice       Decimal             @default(0)
  reorderLevel    Decimal             @default(0)
  currentStock    Decimal             @default(0)
  active          Boolean             @default(true)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  movements       StockMovement[]
  purchaseItems   PurchaseOrderItem[]
  recipeInputs    RecipeItem[]
  recipeOutputs   Recipe[]            @relation("RecipeOutput")
  transfers       StockTransfer[]
}

model StockMovement {
  id        Int               @id @default(autoincrement())
  productId Int
  product   Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  type      StockMovementType
  quantity  Decimal
  note      String?
  batchRef  String?
  staffId   Int?
  staff     TeamMember?       @relation(fields: [staffId], references: [id], onDelete: SetNull)
  createdAt DateTime          @default(now())
}

model Supplier {
  id             Int             @id @default(autoincrement())
  name           String
  contactPerson  String?
  email          String?
  phone          String?
  leadTimeDays   Int             @default(0)
  active         Boolean         @default(true)
  notes          String?
  createdAt      DateTime        @default(now())
  purchaseOrders PurchaseOrder[]
}

model PurchaseOrder {
  id           Int                 @id @default(autoincrement())
  poNumber     String              @unique
  supplierId   Int
  supplier     Supplier            @relation(fields: [supplierId], references: [id])
  status       String              @default("OPEN")
  expectedDate DateTime?
  notes        String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  items        PurchaseOrderItem[]
}

model PurchaseOrderItem {
  id               Int           @id @default(autoincrement())
  purchaseOrderId  Int
  purchaseOrder    PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId        Int
  product          Product       @relation(fields: [productId], references: [id])
  quantityOrdered  Decimal
  quantityReceived Decimal       @default(0)
  unitCost         Decimal       @default(0)
}

model Recipe {
  id              Int          @id @default(autoincrement())
  name            String
  outputProductId Int
  outputProduct   Product      @relation("RecipeOutput", fields: [outputProductId], references: [id])
  outputQuantity  Decimal      @default(1)
  active          Boolean      @default(true)
  notes           String?
  createdAt       DateTime     @default(now())
  items           RecipeItem[]
}

model RecipeItem {
  id        Int      @id @default(autoincrement())
  recipeId  Int
  recipe    Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  productId Int
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Decimal
}

model ProductionBatch {
  id            Int      @id @default(autoincrement())
  batchNumber   String   @unique
  recipeId      Int?
  productName   String
  quantityMade  Decimal
  unit          String   @default("unit")
  status        String   @default("COMPLETED")
  notes         String?
  createdAt     DateTime @default(now())
}

model StockTransfer {
  id             Int      @id @default(autoincrement())
  transferNumber String   @unique
  productId      Int
  product        Product  @relation(fields: [productId], references: [id])
  quantity       Decimal
  fromLocation   String
  toLocation     String
  status         String   @default("COMPLETED")
  note           String?
  createdAt      DateTime @default(now())
}

model TeamMember {
  id           Int             @id @default(autoincrement())
  name         String
  email        String          @unique
  role         String          @default("STAFF")
  active       Boolean         @default(true)
  passwordHash String?
  lastLoginAt  DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @default(now()) @updatedAt
  movements    StockMovement[]
}

/* These two models map Prisma to the live Work Management tables created
   by app/api/work/live-state/route.js. Keeping them in the schema prevents
   `prisma db push` from trying to drop those populated tables on Vercel. */
model WorkLiveState {
  id        Int      @id
  data      Json
  updatedAt DateTime @default(now()) @map("updated_at")
  updatedBy String?  @map("updated_by")

  @@map("work_live_state")
}

model WorkActivity {
  id        BigInt   @id @default(autoincrement())
  actor     String
  eventType String   @default("update") @map("event_type")
  message   String
  urgent    Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("work_activity")
}
